#!/usr/bin/env bash
# One-command desktop launcher for the TNIC RCA dashboard.
#
# Starts Streamlit locally and opens your default browser.
# No Render. No OpenAI required for the core demo.
#
# Usage (from repo root):
#   ./start.demo                 # start + open browser (macOS / Linux / Windows)
#   ./start.demo --port 8503     # alternate port if 8502 is busy
#   ./start.demo --force-install # reinstall Python deps
#
# Windows (double-click or cmd):  start.demo.cmd
# Cloud Agent: prints Cursor Browser URL instead of opening a laptop browser.
#
# Demo path: Handover → XYZ401 → RCA Report
# Docs: docs/DEMO_TNIC_LOCAL_MANAGER.md

set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
exec "$ROOT/scripts/demo_tnic_local.sh" --open "$@"
