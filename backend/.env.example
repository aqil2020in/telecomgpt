# TelecomGPT backend — copy to backend/.env for local development

# --- Core API ---
APP_ENV=development
PORT=8000

# --- LLM (OpenAI recommended for production; Ollama for local) ---
OPENAI_API_KEY=
TELECOMGPT_LLM=openai
TELECOMGPT_LLM_PLAN=1
TELECOMGPT_MODE=orchestrator
TELECOMGPT_ENGINE=langgraph

# --- Memory / RAG (set TELECOMGPT_VECTOR=0 on 2GB Render) ---
TELECOMGPT_VECTOR=0
TELECOMGPT_LOW_MEMORY=1
TELECOMGPT_AUTO_REINDEX=0
TELECOMGPT_MAX_PARALLEL_AGENTS=4

# --- Ask endpoint tuning ---
TELECOMGPT_FAST_ASK=1
TELECOMGPT_ASYNC_ASK=1
LLM_TIMEOUT_FAST_SEC=30

# --- Optional integrations ---
TELECOMGPT_LIVE_FETCH=0
TELECOMGPT_WEB_SEARCH=0
TELECOMGPT_SERVERLESS_URL=
TELECOMGPT_SERVERLESS_TOKEN=

# --- TNIC (embedded RCA engine) ---
LOG_LEVEL=INFO
TNIC_ENABLE_CHROMA=0
TNIC_DATASETS_DIR=
OPENAI_MODEL=gpt-4o-mini
ENABLE_OPENAI_REPORTS=1
RAG_COLLECTION=tnic_knowledge
DATABASE_URL=
