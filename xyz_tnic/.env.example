# XYZ Telecom Network Intelligence Copilot (TNIC)
APP_NAME=XYZ Telecom Network Intelligence Copilot
APP_ENV=development
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# OpenAI (Phase 3 — LLM narrator; optional for rule-only mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL (Render Postgres or local docker-compose)
DATABASE_URL=postgresql://tnic:tnic@localhost:5432/tnic

# ChromaDB vector store
CHROMA_PERSIST_DIR=./data/chroma
RAG_COLLECTION=tnic_knowledge

# Feature flags
ENABLE_OPENAI_REPORTS=1
ENABLE_CHROMA=1

# Streamlit dashboard
STREAMLIT_API_URL=http://localhost:8000
