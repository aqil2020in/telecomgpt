# XYZ TNIC — environment variables (copy to .env)

APP_ENV=development
LOG_LEVEL=INFO
TNIC_ENABLE_CHROMA=1

# OpenAI (optional — template RCA reports used if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ENABLE_OPENAI_REPORTS=1

# Database (SQLite default; set for PostgreSQL in production)
DATABASE_URL=
# Example PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://tnic:tnic@postgres:5432/tnic

# RAG
RAG_COLLECTION=tnic_knowledge

# API (dashboard)
TNIC_API_URL=http://localhost:8000/api/v1

# Render / production
PORT=8000
